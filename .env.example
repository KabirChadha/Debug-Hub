# ==============================================================================
# CAMPUS CODE FIX: Environment Configuration Template
# Duplicate this file as .env.local for local development.
# On Vercel: Set these under Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Credentials (Required)
# Retrieve from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------

# Public URL of your Supabase project (used by both browser and server SSR clients)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key (safe to expose in client-side bundles; governed by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (Required for server-side admin operations that bypass RLS)
# Keep secret! Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Admin Security (Required)
# Passcode required to unlock the /admin engineering console
# ------------------------------------------------------------------------------
ADMIN_ACCESS_KEY=campus-fix-admin-2026

# ------------------------------------------------------------------------------
# 3. Telegram Instant Notification Webhook (Optional)
# If provided, alerts are sent immediately to engineers when a new order is placed.
# Create a bot via @BotFather and retrieve chat ID via @userinfobot
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# 4. Application URL (Optional / Recommended for Vercel)
# Used to format callback links in Telegram notifications
# E.g., https://campus-code-fix.vercel.app or http://localhost:3000
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
